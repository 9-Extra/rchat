# 模型端点列表：可定义多个，前端按会话切换；程序启动时使用第一个作为默认。
# 每个端点必填 api_base / model / api_key，其余有默认值。
endpoints:
  - display_name: "DeepSeek 官方"     # 前端显示名称，默认用 model
    api_base: "https://api.deepseek.com"
    model: "deepseek-v4-flash"
    api_key: "YOUR_API_KEY_HERE"
    api_type: "chat_completions"      # "chat_completions" 或 "responses"，默认chat_completions
    x_opencode_session: false          # 发送每会话固定的 X-Opencode-Session 请求头（opencode-go 端点的风控要求），默认false
  # - display_name: "OpenRouter"
  #   api_base: "https://openrouter.ai/api/v1"
  #   model: "z-ai/glm-5.3-flash"
  #   api_key: "YOUR_OPENROUTER_KEY"
  #   api_type: "chat_completions"
  #   # 发给该端点前给思考强度改名：OpenRouter 的枚举只到 xhigh，没有 max
  #   reasoning_effort_map:
  #     max: "xhigh"
  #   # OpenRouter 的 provider 路由，原样进请求体的 provider 字段
  #   provider:
  #     preferred_min_throughput: 30      # 低于 30 tok/s 的上游移到末尾（软约束，不硬排除）
  #     # sort: "throughput"              # 想按速度而非价格选上游时再加，注意它会关掉默认的负载均衡
  #   session_id: true                    # 把本会话的 chat_id 当请求体 session_id 发出去：
  #                                       # OpenRouter 靠它做粘性路由与上游缓存亲和，命中前缀缓存更稳
  # - display_name: "另一个端点"
  #   api_base: "..."
  #   model: "..."
  #   api_key: "..."

# 以下为全局配置；temperature / max_tokens / reasoning_effort 前端可按会话覆盖
temperature: 0.7         # 默认不设置时请求不带该参数
max_tokens: 100000       # 默认不设置时请求不带该参数
reasoning_effort: "medium"  # 思考强度默认值：none/low/medium/high/max（none=禁用思考）；不设置时按 low 处理
# user_agent: "rchat/0.1"  # 覆盖 SDK 默认 UA（opencode-go 等端点风控拒绝语言默认 UA）

# 联网工具（web_search / web_fetch）：打的是 DeepSeek 的 Search / Fetch 接口，与模型端点
# 各自独立配置。api_key 就是 DeepSeek API Key，直接把端点上那个 key 复制过来即可。
# 只有预设的 tools 列表里启用了 web_search / web_fetch 才用得上这一段（不写不报错）。
web_tools:
  api_base: "https://api.deepseek.com"   # 默认就是这个
  api_key: "YOUR_DEEPSEEK_API_KEY"
  timeout: 60                            # 单次请求超时（秒），默认 60
  count: 10                              # web_search 默认的返回条数（1~50），默认 10

# 服务端设置（本地自己跑时整段可以不管）
server:
  max_concurrent_generations: 4  # 全服务器同时在跑的生成上限，多出来的排队；改了要重启才生效

# 用户名密码鉴权：enabled 为 false（或默认）时不做鉴权，只要网络可达即可访问，用于单机和局域网环境。
# 放服务器上时改成 true 并填账号，同时把这个文件 chmod 600（里面有 API key 和明文密码）。
auth:
  enabled: false
  users:
    alice: "换一个强密码"
    # bob: "另一个强密码"
  session_ttl_days: 30    # 登录态有效期（天）
  cookie_secure: false    # 走 https 反代时置 true

